# ghrouter configuration
# Copy to config.yaml and adjust as needed

listen_port: 9090

# Provider definitions — auto-discovered at startup if missing
# Each provider maps to a local CLI binary
providers:
  - name: "claude-code"
    type: "claude-code"                    # one of: claude-code, codex, opencode, mimo, pi, openai, anthropic, azure, ollama, custom
    cli_path: ""                           # empty = auto-discover on PATH
    args: ["--print", "--output-format=stream-json", "--no-session-persistence"]
    env: {}                                # extra env vars (merged with inherited auth vars)
    models: []                             # empty = use built-in aliases
    timeout: "5m"                          # request timeout
    max_tokens: 128000                     # max tokens per request
    work_dir: ""                           # empty = current directory
    auth_method: "env"                     # env, file, subprocess, none
    enabled: true

  - name: "codex"
    type: "codex"
    cli_path: ""
    args: ["exec", "--json", "--ephemeral", "--skip-git-repo-check"]
    env: {}
    models: []
    timeout: "5m"
    max_tokens: 128000
    work_dir: ""
    auth_method: "env"
    enabled: true

  - name: "opencode"
    type: "opencode"
    cli_path: ""
    args: ["run", "--format", "json", "--no-remote"]
    env: {}
    models: []
    timeout: "5m"
    max_tokens: 128000
    work_dir: ""
    auth_method: "env"
    enabled: true

  - name: "mimo"
    type: "mimo"
    cli_path: ""
    args: ["run", "--format", "json", "--pure"]
    env: {}
    models: []
    timeout: "5m"
    max_tokens: 128000
    work_dir: ""
    auth_method: "env"
    enabled: true

  - name: "pi"
    type: "pi"
    cli_path: ""
    args: ["--mode", "json", "--print", "--no-session", "--no-context-files"]
    env: {}
    models: []
    timeout: "5m"
    max_tokens: 128000
    work_dir: ""
    auth_method: "env"
    enabled: true

# Routing table — maps requested model patterns to providers + combo modes
# Patterns support * wildcard suffix
routes:
  # Explicit provider prefixes (highest priority)
  - pattern: "cc/*"
    provider: "claude-code"
    fallback: ["codex", "opencode"]
    mode: "fallback"                      # fallback, round-robin, fusion, sticky, auto

  - pattern: "cx/*"
    provider: "codex"
    fallback: ["claude-code"]
    mode: "fallback"

  - pattern: "oc/*"
    provider: "opencode"
    fallback: ["claude-code", "codex"]
    mode: "fallback"

  - pattern: "mi/*"
    provider: "mimo"
    fallback: ["opencode", "codex"]
    mode: "fallback"

  - pattern: "pi/*"
    provider: "pi"
    fallback: ["claude-code", "codex"]
    mode: "fallback"

  # Combo modes (no prefix)
  - pattern: "auto/*"
    provider: "auto"                      # picks best by health/latency/capability
    fallback: []
    mode: "auto"

  - pattern: "pool/*"
    provider: "round-robin"               # distributes across fallback list
    fallback: ["cx/gpt-4o", "oc/sonnet", "pi/gpt-5-mini", "cc/claude-sonnet-5"]
    mode: "round-robin"

  - pattern: "fusion/*"
    provider: "fusion"                    # parallel, returns first complete
    fallback: ["cc/claude-opus-5", "cx/o3", "oc/sonnet"]
    mode: "fusion"

  - pattern: "sticky/*"
    provider: "sticky"                    # same conversation ID -> same provider
    fallback: []
    mode: "sticky"

# Model cooldown settings
cooldown:
  enabled: true
  default_duration: "60s"                 # cooldown after error/timeout
  max_duration: "300s"
  error_threshold: 3                      # consecutive errors before cooldown
  timeout_threshold: 2                    # consecutive timeouts before cooldown

# Health check settings
health:
  interval: "30s"                         # periodic check interval
  timeout: "10s"                          # single check timeout
  test_prompt: "ping"                     # prompt used for health checks
  enabled: true

# Logging
logging:
  level: "info"                           # debug, info, warn, error
  format: "json"                          # json, text
  output: "stdout"                        # stdout, stderr, file

# Server settings
server:
  host: "127.0.0.1"                       # bind address
  read_timeout: "30s"
  write_timeout: "180s"                   # allow long streaming
  idle_timeout: "60s"